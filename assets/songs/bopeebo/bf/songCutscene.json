{
  "id": "test_cutscene",
  "skippable": true,
  "canPause": false,
  "actors": [
    {
      "character": "player",
      "bindExisting": true
    },
    {
      "character": "opponent",
      "bindExisting": true
    }
  ],
  "actions": [
    { "type": "fade", "target": "camHUD", "duration": 1.3, "values": { "direction": "in", "color": "#000000" } },
	{ "type": "camera", "target": "opponent", "duration": 1.5, "ease": "expoOut" },
    { "type": "playAnim", "target": "opponent", "duration": 1, "values": { "anim": "singUP", "force": true } },
	{ "type": "playAnim", "target": "opponent", "duration": 0.1, "values": { "anim": "idle-0", "force": true } },
	{ "type": "camera", "target": "player", "duration": 0.6, "ease": "expoOut" },
    { "type": "playAnim", "target": "player", "duration": 1.2, "values": { "anim": "hey", "force": true } },
    { "type": "wait", "duration": 1 }
  ]
}